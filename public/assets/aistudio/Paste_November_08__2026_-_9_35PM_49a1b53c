<button class="flex flex-col items-center justify-center p-3 rounded-xl bg-surface-container text-on-surface-variant shadow-sm transition-all duration-200" id="btnPrioritasTinggi" onclick="setPriority('tinggi')" type="button">
<span class="material-symbols-outlined text-[20px] mb-0.5">priority_high</span>
<span class="font-label-md text-label-md">Tinggi</span>
