<script>
  function toggleTaskDone(button) {
    const card = button.closest('.task-card');
    const heading = card.querySelector('.task-heading');
    const isCompleted = button.classList.contains('bg-secondary');

    if (!isCompleted) {
      button.classList.remove('bg-surface-container', 'text-transparent');
      button.classList.add('bg-secondary', 'text-on-secondary');
      heading.classList.add('line-through', 'opacity-50');
      card.classList.add('opacity-75');
    } else {
      button.classList.add('bg-surface-container', 'text-transparent');
      button.classList.remove('bg-secondary', 'text-on-secondary');
      heading.classList.remove('line-through', 'opacity-50');
      card.classList.remove('opacity-75');
    }
  }

  // Live Search filter
  const searchInput = document.getElementById('searchInput');
  const clearBtn = document.getElementById('clearSearchBtn');
  const taskCards = document.querySelectorAll('.task-card');

  searchInput.addEventListener('input', function(e) {
    const query = e.target.value.toLowerCase().trim();
    if (query.length > 0) {
      clearBtn.classList.remove('hidden');
    } else {
      clearBtn.classList.add('hidden');
    }

    let visibleCount = 0;
    taskCards.forEach(card => {
      const title = card.getAttribute('data-title').toLowerCase();
      const matkul = card.getAttribute('data-matkul').toLowerCase();
      if (title.includes(query) || matkul.includes(query)) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    const statusText = document.getElementById('statusCounter');
    statusText.innerHTML = `Daftar Tugas Pending Ditampilkan (<span class="font-semibold text-primary">${visibleCount} tugas aktif</span>)`;
  });

  clearBtn.addEventListener('click', function() {
    searchInput.value = '';
    clearBtn.classList.add('hidden');
    taskCards.forEach(card => card.style.display = 'flex');
    const statusText = document.getElementById('statusCounter');
    statusText.innerHTML = `Daftar Tugas Pending Ditampilkan (<span class="font-semibold text-primary">4 tugas aktif</span>)`;
    searchInput.focus();
  });
</script></main><div class="fixed bottom-0 w-full z-50 pb-safe pointer-events-none px-margin"><nav class="pointer-events-auto mx-auto max-w-md mb-space-sm bg-surface-container-lowest/90 backdrop-blur-xl rounded-full shadow-[0_8px_24px_-4px_rgba(15,23,42,0.08),0_20px_32px_-4px_rgba(79,70,229,0.06)] px-space-xs py-1.5 flex items-center justify-around" data-active-classes="text-primary font-semibold [&amp;&gt;span.material-symbols-outlined]:scale-110 [&amp;&gt;span.material-symbols-outlined]:text-primary"><a class="flex flex-col items-center justify-center min-w-[64px] min-h-[48px] px-space-xs py-1 rounded-full text-on-surface-variant hover:text-on-surface transition-all gap-0.5" data-path="beranda" href="#"><span class="material-symbols-outlined text-[22px] transition-transform">dashboard</span><span class="font-label-sm text-[10px] leading-tight">Beranda</span></a><a class="flex flex-col items-center justify-center min-w-[64px] min-h-[48px] px-space-xs py-1 rounded-full text-on-surface-variant hover:text-on-surface transition-all gap-0.5" data-path="tambah-tugas" href="#"><span class="material-symbols-outlined text-[22px] transition-transform">add_circle</span><span class="font-label-sm text-[10px] leading-tight">Tambah</span></a><a aria-current="page" class="flex flex-col items-center justify-center min-w-[64px] min-h-[48px] px-space-xs py-1 rounded-full transition-all gap-0.5 text-primary font-semibold [&amp;&gt;span.material-symbols-outlined]:scale-110 [&amp;&gt;span.material-symbols-outlined]:text-primary" data-path="daftar-tugas" href="#"><span class="material-symbols-outlined text-[22px] transition-transform">checklist</span><span class="font-label-sm text-[10px] leading-tight">Daftar Tugas</span></a><a class="flex flex-col items-center justify-center min-w-[64px] min-h-[48px] px-space-xs py-1 rounded-full text-on-surface-variant hover:text-on-surface transition-all gap-0.5" data-path="pengingat-deadline" href="#"><span class="material-symbols-outlined text-[22