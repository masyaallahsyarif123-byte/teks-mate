</button>
<button class="flex flex-col items-center justify-center p-3 rounded-xl bg-surface-container text-on-surface-variant shadow-sm transition-all duration-200" id="btnPrioritasSedang" onclick="setPriority('sedang')" type="button">
<span class="material-symbols-outlined text-[20px] mb-0.5">hourglass_top</span>
<span class="font-label-md text-label-md">Sedang</span>
<span class="font-label-sm text-[10px] opacity-80 mt-0.5">1-3 Hari</span>
</button>
<button class="flex flex-col items-center justify-center p-3 rounded-xl bg-surface-container text-on-surface-variant shadow-sm transition-all duration-200" id="btnPrioritasRendah" onclick="setPriority('rendah')" type="button">
<span class="material-symbols-outlined text-[20px] mb-0.5">low_priority</span>
<span class="font-label-md text-label-md">Rendah</span>
<span class="font-label-sm text-[10px] opacity-80 mt-0.5">&gt; 3 Hari</span>
</button>
</div>
<input id="prioritasInput" type="hidden" value="">
</div>
<div class="flex flex-col gap-space-xs">
<label class="font-label-md text-label-md text-on-surface-variant flex items-center justify-between" for="catatan">
<span class="">Catatan / Link Pengumpulan</span>
<span class="font-label-sm text-label-sm text-outline">Opsional</span>
</label>
<div class="relative rounded-xl bg-surface-container-lowest shadow-sm">
<textarea class="w-full p-3.5 rounded-xl bg-transparent font-body-md text-body-md text-on-surface placeholder:text-outline focus:outline-none focus:bg-surface-container-low transition-colors resize-none" id="catatan" placeholder="Tuliskan format submission, tautan Google Drive / Portal Kuliah, atau instruksi dosen..." rows="3"></textarea>
</div>
</div>
<div class="rounded-xl bg-surface-container-low p-space-md shadow-sm flex flex-col gap-space-sm">
<div class="flex items-center justify-between gap-space-md">
<div class="flex items-center gap-space-sm min-w-0">
<div class="w-10 h-10 rounded-full bg-secondary-fixed flex items-center justify-center text-on-secondary-fixed flex-shrink-0">
<span class="material-symbols-outlined text-[20px]">notifications_active</span>
</div>
<div class="flex flex-col min-w-0">
<span class="font-label-lg text-label-lg text-on-surface truncate">Set Alarm Pengingat Sistem</span>
<span class="font-body-sm text-body-sm text-on-surface-variant truncate">Notifikasi suara &amp; banner otomatis</span>
</div>
</div>
<label class="relative inline-flex items-center cursor-pointer flex-shrink-0">
<input checked="" class="sr-only peer" id="alarmToggle" onchange="toggleAlarmDetails()" type="checkbox">
<div class="w-12 h-6 bg-outline-variant peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-surface-container-lowest after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
</label>
</div>
<div class="flex items-center gap-space-xs pt-1 transition-opacity" id="alarmSpecs">
<span class="px-2.5 py-1 rounded-full bg-surface-container-high text-on-surface font-label-sm text-label-sm flex items-center gap-1">
<span class="material-symbols-outlined text-[14px] text-primary">schedule</span> 1 Hari Sebelum
        </span>
<span class="px-2.5 py-1 rounded-full bg-surface-container-high text-on-surface font-label-sm text-label-sm flex items-center gap-1">
<span class="material-symbols-outlined text-[14px] text-tertiary">alarm</span> 3 Jam Sebelum
        </span>
</div>
</div>
<div class="pt-space-xs">
<button class="w-full py-4 px-space-lg rounded-xl font-label-lg text-label-lg font-bold flex items-center justify-center gap-space-sm shadow-md transition-all duration-200 opacity-50 bg-primary text-on-primary cursor-not-allowed" disabled="" id="submitBtn" type="submit">
<span class="material-symbols-outlined text-[20px]">cloud_upload</span>
<span class="">Simpan ke Database &amp; Set Alarm</span>
</button>
</div>
</form>
<div class="fixed inset-0 z-50 flex items-center justify-center bg-inverse-surface/40 backdrop-blur-sm p-margin opacity-0 pointer-events-none transition-all duration-300" id="successModal">
<div class="w-full max-w-sm rounded-xl bg-surface-container-lowest p-space-xl shadow-xl flex flex-col items-center text-center transform scale-95 transition-all duration-300" id="modalBox">
<div class="w-16 h-16 rounded-full bg-secondary-fixed flex items-center justify-center text-on-secondary-fixed mb-space-md">
<span class="material-symbols-outlined text-[36px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
</div>
<h3 class="font-headline-md text-headline-md text-on-surface mb-space-xs">Tugas dan Deadline Berhasil Disimpan!</h3>
<p class="font-body-sm text-body-sm text-on-surface-variant mb-space-lg">
        Tugas telah masuk ke antrean database lokal. Pengingat 24 jam &amp; 3 jam sebelum deadline telah diaktifkan di perangkat Anda.
      </p>
<div class="w-full rounded-xl bg-surface-container p-space-sm mb-space-lg text-left flex flex-col gap-1">
<div class="flex items-center justify-between">
<span class="font-label-sm text-label-sm text-outline">Matkul:</span>
<span class="font-label-sm text-label-sm text-on-surface font-semibold truncate max-w-[180px]" id="previewMatkul">-</span>
</div>
<div class="flex items-center justify-between">
<span class="font-label-sm text-label-sm text-outline">Deadline:</span>
<span class="font-label-sm text-label-sm text-on-surface font-semibold" id="previewDeadline">-</span>
</div>
</div>
<div class="w-full flex flex-col gap-space-xs">
<button class="w-full py-3 rounded-xl bg-primary text-on-primary font-label-lg text-label-lg font-semibold shadow-sm active:scale-95 transition-transform" onclick="closeModalAndReset()" type="button">
          Lihat Daftar Tugas
        </button>
<button class="w-full py-2.5 rounded-xl bg-surface-container text-on-surface font-label-sm text-label-sm active:scale-95 transition-transform" onclick="closeModalOnly()" type="button">
          Tambah Tugas Lain
        </button>
</div>
</div>
</div>
</div>
<script>
  (function initDatePicker() {
    const today = new Date();
    const yyyy = today.getFullYear();
    const mm = String(today.getMonth() + 1).padStart(2, '0');
    const dd = String(today.getDate()).padStart(2, '0');
    const minDate = `${yyyy}-${mm}-${dd}`;
    const dateInput = document.getElementById('deadlineTanggal');
    if (dateInput) {
      dateInput.min = minDate;
      dateInput.value = minDate;
    }
  })();

  function setPriority(level) {
    const hidden = document.getElementById('prioritasInput');
    const label = document.getElementById('priorityLabel');
    const btnTinggi = document.getElementById('btnPrioritasTinggi');
    const btnSedang = document.getElementById('btnPrioritasSedang');
    const btnRendah = document.getElementById('btnPrioritasRendah');

    hidden.value = level;

    btnTinggi.className = 'flex flex-col items-center justify-center p-3 rounded-xl bg-surface-container text-on-surface-variant shadow-sm transition-all duration-200';
    btnSedang.className = 'flex flex-col items-center justify-center p-3 rounded-xl bg-surface-container text-on-surface-variant shadow-sm transition-all duration-200';
    btnRendah.className = 'flex flex-col items-center justify-center p-3 rounded-xl bg-surface-container text-on-surface-variant shadow-sm transition-all duration-200';

    if (level === 'tinggi') {
      btnTinggi.className = 'flex flex-col items-center justify-center p-3 rounded-xl bg-error text-on-error shadow-sm transition-all duration-200';
      label.textContent = 'Tinggi (Mendesak)';
      label.className = 'font-label-sm text-label-sm text-error font-semibold';
    } else if (level === 'sedang') {
      btnSedang.className = 'flex flex-col items-center justify-center p-3 rounded-xl bg-tertiary-container text-on-tertiary-container shadow-sm transition-all duration-200';
      label.textContent = 'Sedang (Menengah)';
      label.className = 'font-label-sm text-label-sm text-tertiary font-semibold';
    } else {
      btnRendah.className = 'flex flex-col items-center justify-center p-3 rounded-xl bg-secondary text-on-secondary shadow-sm transition-all duration-200';
      label.textContent = 'Rendah (Fleksibel)';
      label.className = 'font-label-sm text-label-sm text-secondary font-semibold';
    }
  }

  function updateCharCount() {
    const input = document.getElementById('judulTugas');
    const counter = document.getElementById('charCountJudul');
    counter.textContent = `${input.value.length}/80`;
  }

  function toggleAlarmDetails() {
    const isChecked = document.getElementById('alarmToggle').checked;
    const specs = document.getElementById('alarmSpecs');
    if (isChecked) {
      specs.style.opacity = '1';
      specs.style.pointerEvents = 'auto';
    } else {
      specs.style.opacity = '0.35';
      specs.style.pointerEvents = 'none';
    }
  }

  function validateForm() {
    const judul = document.getElementById('judulTugas').value.trim();
    const matkul = document.getElementById('namaMatkul').value.trim();
    const tanggal = document.getElementById('deadlineTanggal').value;
    const jam = document.getElementById('jamBatas').value;
    const submitBtn = document.getElementById('submitBtn');

    const isValid = judul.length > 2 && matkul.length > 1 && Boolean(tanggal) && Boolean(jam);

    if (isValid) {
      submitBtn.disabled = false;
      submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
      submitBtn.classList.add('hover:opacity-90', 'active:scale-[0.98]');
    } else {
      submitBtn.disabled = true;
      submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
      submitBtn.classList.remove('hover:opacity-90', 'active:scale-[0.98]');
    }
  }

  function handleTaskSubmit() {
    const matkul = document.getElementById('namaMatkul').value.trim();
    const tanggal = document.getElementById('deadlineTanggal').value;
    const jam = document.getElementById('jamBatas').value;

    document.getElementById('previewMatkul').textContent = matkul;
    document.getElementById('previewDeadline').textContent = `${tanggal} • ${jam} WIB`;

    const modal = document.getElementById('successModal');
    const box = document.getElementById('modalBox');

    modal.classList.remove('opacity-0', 'pointer-events-none');
    modal.classList.add('opacity-100', 'pointer-events-auto');
    box.classList.remove('scale-95');
    box.classList.add('scale-100');
  }

  function closeModalOnly() {
    const modal = document.getElementById('successModal');
    const box = document.getElementById('modalBox');

    modal.classList.remove('opacity-100', 'pointer-events-auto');
    modal.classList.add('opacity-0', 'pointer-events-none');
    box.classList.remove('scale-100');
    box.classList.add('scale-95');

    document.getElementById('taskForm').reset();
    setPriority('tinggi');
    updateCharCount();
    validateForm();
  }

  function closeModalAndReset() {
    closeModalOnly();
    const targetTab = document.querySelector('a[data-path="daftar-tugas"]');
    if (targetTab) {
      targetTab.click();
