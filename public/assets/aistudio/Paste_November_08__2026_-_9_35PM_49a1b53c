    } else {
      urgentView.classList.add('hidden');
      urgentView.classList.remove('flex');
      safeView.classList.remove('hidden');
      safeView.classList.add('flex');

      btnSafe.className = 'flex-1 py-1.5 px-3 rounded font-label-md text-label-md text-center transition-all bg-surface-container-lowest text-secondary shadow-sm font-semibold';
