</div>
<div class="flex flex-col gap-space-xs min-w-0">
<label class="font-label-md text-label-md text-on-surface-variant" for="jamBatas">
          Jam Pengumpulan <span class="text-error">*</span>
</label>
<div class="relative flex items-center rounded-xl bg-surface-container-lowest shadow-sm">
<span class="material-symbols-outlined absolute left-3 text-on-surface-variant text-[18px]">schedule</span>
<input class="w-full pl-9 pr-3 py-3 rounded-xl bg-transparent font-body-md text-body-md text-on-surface focus:outline-none focus:bg-surface-container-low transition-colors" id="jamBatas" oninput="validateForm()" required="" type="time">
</div>
</div>
</div>
<div class="flex flex-col gap-space-xs">
<div class="flex items-center justify-between">
<span class="font-label-md text-label-md text-on-surface-variant">Tingkat Prioritas <span class="text-error">*</span></span>
<span class="font-label-sm text-label-sm text-outline font-semibold" id="priorityLabel" style="opacity: 0;">Pilih Prioritas</span>
</div>
